{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "home-continuity",
  "main": "./worker.js",
  "compatibility_date": "2026-09-25",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "home-continuity.nxsio.com", "custom_domain": true }],
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "HOME_DB",
      "database_name": "home-continuity",
      "database_id": "9fbdaffe-7481-498e-9c00-9f42bd1f2c4a",
      "migrations_dir": "migrations"
    }
  ],
  "secrets": {
    "required": ["CONTINUITY_MCP_URL", "CORE_SHARED_SECRET", "NEMOTRON_API_KEY"]
  }
}
